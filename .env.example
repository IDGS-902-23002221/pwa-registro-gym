# Variables de entorno del frontend.
#
# Copiar este archivo a .env en la raíz y completar con los valores reales.
# .env está en .gitignore: nunca se commitean valores reales.
#
# Las dos variables usan el prefijo VITE_ porque son públicas por diseño:
# viajan dentro del bundle del navegador. La clave anon da acceso limitado
# por las Row Level Security policies de Supabase, nunca acceso admin.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
